{
  "name": "servico-pagamento",
  "version": "1.0.0",
  "description": "Projeto acadêmico de serviço de pagamento com testes automatizados e integração contínua utilizando GitHub Actions.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "mocha \"test/**/*.test.js\"",
    "test:report": "mocha \"test/**/*.test.js\" --reporter mochawesome --reporter-options reportDir=reports,reportFilename=relatorio-testes,html=true,json=true,overwrite=true"
  },
  "devDependencies": {
    "mocha": "^11.7.0",
    "mochawesome": "^7.1.4"
  }
}